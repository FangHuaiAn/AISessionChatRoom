{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aichat-local-maintenance-bridge",
  "account_id": "0cfbb72c4eab7aaf66611ab26f2e9d75",
  "main": "bridge.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1", "port": 8790 },
  "services": [
    {
      "binding": "CHAT",
      "service": "ai-session-chatroom",
      "entrypoint": "Maintenance",
    },
  ],
  "env": {
    "remote": {
      "services": [
        {
          "binding": "CHAT",
          "service": "ai-session-chatroom",
          "entrypoint": "Maintenance",
          "remote": true,
        },
      ],
    },
  },
}
