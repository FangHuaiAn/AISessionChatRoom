{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aichat-local-recovery-target-bridge",
  "main": "bridge.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1", "port": 8792 },
  "services": [
    {
      "binding": "CHAT",
      "service": "ai-session-chatroom-recovery-drill",
      "entrypoint": "Maintenance",
    },
  ],
}
