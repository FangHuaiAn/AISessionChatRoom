{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ai-session-chatroom-recovery-drill",
  "main": "../src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1", "port": 8791 },
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": { "GITHUB_CLIENT_ID": "" },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ROOMS", "class_name": "Room" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory", "Room"] }],
}
