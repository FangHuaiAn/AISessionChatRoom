{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-session-chatroom",
  "account_id": "0cfbb72c4eab7aaf66611ab26f2e9d75",
  "routes": [
    {
      "pattern": "https://apiwx.net/chat",
      "zone_id": "bf943899cf00a7ea36f8d1f077b477d2",
    },
    {
      "pattern": "https://apiwx.net/chat/*",
      "zone_id": "bf943899cf00a7ea36f8d1f077b477d2",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "GITHUB_CLIENT_ID": "" },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ROOMS", "class_name": "Room" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory", "Room"] }],
}
